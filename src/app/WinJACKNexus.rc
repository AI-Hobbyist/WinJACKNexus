#define IDI_ICON1 101

IDI_ICON1 ICON "../../ico/WinJACKNexus.ico"
#include <winver.h>

1 VERSIONINFO
 FILEVERSION 1,0,1,0
 PRODUCTVERSION 1,0,1,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "WinJACKNexus"
            VALUE "FileVersion", "1.0.1.0"
            VALUE "InternalName", "WinJACKNexus"
            VALUE "OriginalFilename", "WinJACKNexus.exe"
            VALUE "ProductName", "WinJACKNexus"
            VALUE "ProductVersion", "1.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
