{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:winjacknexus:i18n:v1:manifest",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "moduleId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,255}$"
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,255}$"
      }
    },
    "defaultLanguage": {
      "const": "en-US"
    },
    "catalogVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "languages": {
      "type": "object",
      "required": [
        "en-US"
      ],
      "properties": {
        "en-US": {
          "const": "en-US.json"
        },
        "zh-CN": {
          "const": "zh-CN.json"
        },
        "ja-JP": {
          "const": "ja-JP.json"
        },
        "ko-KR": {
          "const": "ko-KR.json"
        }
      },
      "additionalProperties": false
    },
    "requiredKeys": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,255}$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,255}$"
        }
      }
    }
  },
  "required": [
    "formatVersion",
    "moduleId",
    "domains",
    "defaultLanguage",
    "catalogVersion",
    "languages",
    "requiredKeys"
  ],
  "additionalProperties": false
}
